{
  "name": "margin",
  "productName": "Margin",
  "version": "0.5.1",
  "description": "Agent-assisted writing app — co-edit markdown documents with Claude in review rounds",
  "main": "./out/main/index.js",
  "author": "Drew Hays <drew@hays.fm>",
  "license": "MIT",
  "homepage": "https://github.com/Dru89/margin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dru89/margin.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "test:state": "node scripts/test-review-state.mjs",
    "test:anchors": "node scripts/test-anchors.mjs",
    "test": "npm run test:state && npm run test:anchors && npm run test:worddiff && npm run test:composer && npm run test:mentions && npm run test:paths && npm run test:workspace && npm run test:sidecar && npm run test:tables && npm run test:git && npm run test:errors && npm run test:contract",
    "test:composer": "node scripts/test-composer.mjs",
    "test:mentions": "node scripts/test-mentions.mjs",
    "test:paths": "node scripts/test-paths.mjs",
    "test:workspace": "node scripts/test-workspace.mjs",
    "test:sidecar": "node scripts/test-sidecar.mjs",
    "test:tables": "node scripts/test-tables.mjs",
    "test:git": "node scripts/test-git.mjs",
    "test:errors": "node scripts/test-agent-errors.mjs",
    "test:contract": "node scripts/test-agent-contract.mjs",
    "test:live": "node scripts/test-live-round.mjs",
    "test:e2e": "npm run build && npx playwright test",
    "fixture": "node scripts/make-fixture.mjs",
    "test:worddiff": "node scripts/test-worddiff.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/newsreader": "^5.1.0",
    "@fontsource-variable/spline-sans": "^5.1.0",
    "@fontsource-variable/spline-sans-mono": "^5.1.0",
    "@lezer/highlight": "^1.2.0",
    "electron-updater": "^6.8.9",
    "nanoid": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "fm.hays.margin",
    "productName": "Margin",
    "asar": false,
    "files": [
      "out/**/*",
      "build/*.png",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dru89",
        "repo": "margin"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
